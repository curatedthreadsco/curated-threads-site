---
import { Image } from 'astro:assets';
import logo from '../assets/logo-round.jpg';
import banner from '../assets/banner-transparent.jpg';

const { pathname } = Astro.url;

const navItems = [
  { label: 'Hunting', href: '/hunting' },
  { label: 'Fishing', href: '/fishing' },
  { label: 'Outdoor', href: '/outdoor' },
  { label: 'Patriotic', href: '/patriotic' },
  { label: 'Gift Guides', href: '/gift-guides' },
  { label: 'Story', href: '/story' },
  { label: 'FAQ', href: '/faq' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---

<header class="bg-parchment">
  <a
    href="/"
    class="block bg-parchment"
    aria-label="Curated Threads Outdoors home"
  >
    <Image
      src={banner}
      alt="Curated Threads Outdoors"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      quality={92}
      class="mx-auto block w-full max-w-6xl"
      loading="eager"
    />
  </a>
  <nav aria-label="Main" class="border-y border-gold/30 bg-parchment">
    <ul class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-6 gap-y-2 px-6 py-3 text-sm font-semibold uppercase tracking-wider text-sepia">
      <li class="sm:hidden">
        <a href="/" class="flex items-center gap-2" aria-label="Home">
          <Image src={logo} alt="" widths={[40, 80, 120]} sizes="40px" quality={92} class="h-10 w-10 rounded-full border border-gold/50 object-cover" />
        </a>
      </li>
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'transition hover:text-forest',
                isActive(item.href) && 'text-forest underline underline-offset-8 decoration-gold decoration-2',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
