---
import { Image } from 'astro:assets';
import logo from '../assets/logo-round.jpg';
import banner from '../assets/banner-transparent.jpg';

const { pathname } = Astro.url;

const navItems = [
  { label: 'Hunting', href: '/hunting' },
  { label: 'Fishing', href: '/fishing' },
  { label: 'Outdoor', href: '/outdoor' },
  { label: 'Patriotic', href: '/patriotic' },
  { label: 'Gift Guides', href: '/gift-guides' },
  { label: 'Story', href: '/story' },
  { label: 'FAQ', href: '/faq' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---

<a
  href="/"
  class="block bg-parchment px-6 pt-3 pb-2"
  aria-label="Curated Threads Outdoors home"
>
  <Image
    src={banner}
    alt="Curated Threads Outdoors"
    widths={[480, 720, 960, 1200]}
    sizes="(min-width: 1024px) 720px, 90vw"
    quality={92}
    class="mx-auto block w-full max-w-2xl"
    loading="eager"
  />
</a>
<nav
  aria-label="Main"
  class="sticky top-0 z-40 border-y border-gold/30 bg-parchment/95 shadow-sm backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-2">
    <a href="/" class="shrink-0" aria-label="Curated Threads Outdoors home">
      <Image
        src={logo}
        alt=""
        widths={[48, 96, 144]}
        sizes="48px"
        quality={92}
        class="rounded-full border border-gold/50 object-cover"
        style="height: 3rem; width: 3rem;"
      />
    </a>
    <ul class="flex flex-1 flex-wrap items-center justify-end gap-x-5 gap-y-1 text-sm font-semibold uppercase tracking-wider text-sepia">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'transition hover:text-forest',
                isActive(item.href) && 'text-forest underline underline-offset-8 decoration-gold decoration-2',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
