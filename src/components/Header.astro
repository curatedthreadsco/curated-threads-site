---
import { Image } from 'astro:assets';
import logo from '../assets/logo-round.jpg';
import banner from '../assets/banner-transparent.png';

const { pathname } = Astro.url;

const navItems = [
  { label: 'Hunting', href: '/hunting' },
  { label: 'Fishing', href: '/fishing' },
  { label: 'Outdoor', href: '/outdoor' },
  { label: 'Patriotic', href: '/patriotic' },
  { label: 'Gift Guides', href: '/gift-guides' },
  { label: 'Story', href: '/story' },
  { label: 'FAQ', href: '/faq' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---

<div class="bg-forest-dark px-6 py-2 text-center text-[11px] font-semibold uppercase tracking-[0.2em] text-cream">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-4 gap-y-1">
    <span>Free Shipping</span>
    <span class="text-gold">&middot;</span>
    <span>Made to Order</span>
    <span class="text-gold">&middot;</span>
    <span>Family Owned</span>
    <span class="text-gold">&middot;</span>
    <span>Fulfilled via Etsy</span>
  </div>
</div>
<div class="bg-parchment py-2">
  <a
    href="/"
    class="mx-auto block w-full max-w-4xl px-4"
    aria-label="Curated Threads Outdoors home"
  >
    <Image
      src={banner}
      alt="Curated Threads Outdoors"
      widths={[480, 720, 900, 1200, 1600]}
      sizes="(min-width: 896px) 896px, 100vw"
      quality={92}
      class="block h-auto w-full"
      loading="eager"
    />
  </a>
</div>
<nav
  aria-label="Main"
  class="sticky top-0 z-40 border-y border-gold/30 bg-parchment/95 shadow-sm backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-6 gap-y-2 px-6 py-2">
    <a href="/" class="shrink-0" aria-label="Curated Threads Outdoors home">
      <Image
        src={logo}
        alt=""
        widths={[48, 96, 144]}
        sizes="48px"
        quality={92}
        class="rounded-full border border-gold/50 object-cover"
        style="height: 3rem; width: 3rem;"
      />
    </a>
    <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-1 text-sm font-semibold uppercase tracking-wider text-sepia">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'transition hover:text-forest',
                isActive(item.href) && 'text-forest underline underline-offset-8 decoration-gold decoration-2',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
