---
const social = [
  { name: 'Instagram', url: 'https://www.instagram.com/curatedthreadsoutdoors/' },
  { name: 'TikTok', url: 'https://www.tiktok.com/@curatedthreadsoutdoors' },
  { name: 'Pinterest', url: 'https://www.pinterest.com/CuratedThreadsOutdoors' },
  { name: 'Facebook', url: 'https://www.facebook.com/profile.php?id=61587888253398' },
];

const etsyShopUrl =
  'https://curatedthreadsllc.etsy.com/?utm_source=curatedthreadsllc&utm_medium=web&utm_campaign=footer';

const year = new Date().getFullYear();
---

<footer class="bg-forest-dark px-6 py-12 text-cream/80">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 sm:flex-row sm:items-start sm:justify-between">
    <div class="text-center sm:text-left">
      <p class="font-display text-lg tracking-wide text-cream">Curated Threads LLC</p>
      <p class="mt-1 text-sm text-cream/60">Hand-picked styles. Classic pieces. Timeless elegance.</p>
      <a
        href={etsyShopUrl}
        target="_blank"
        rel="noopener"
        class="mt-3 inline-block text-sm font-semibold uppercase tracking-wider text-blaze hover:text-cream"
      >
        Shop on Etsy &rarr;
      </a>
    </div>
    <nav aria-label="Social">
      <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm">
        {
          social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" class="underline-offset-4 hover:text-blaze hover:underline">
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="mx-auto mt-10 max-w-6xl border-t border-cream/10 pt-6 text-center text-xs text-cream/50">
    <p>&copy; {year} Curated Threads LLC. All orders placed and fulfilled through Etsy.</p>
  </div>
</footer>
