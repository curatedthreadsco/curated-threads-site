---
import BaseLayout from '../layouts/BaseLayout.astro';

const etsyShopUrl =
  'https://curatedthreadsllc.etsy.com/?utm_source=curatedthreadsllc&utm_medium=web&utm_campaign=home';

const categories = [
  { name: 'Hunting', blurb: 'Deer camp humor and gear for the hunter in your life.' },
  { name: 'Fishing', blurb: 'Designs for the angler who lives for the next cast.' },
  { name: 'Outdoor', blurb: 'For campfires, trails, and everyone who loves being outside.' },
  { name: 'Patriotic', blurb: 'Red, white, and blue designs made in the USA.' },
];

const social = [
  { name: 'Instagram', url: 'https://www.instagram.com/curatedthreads_co' },
  { name: 'TikTok', url: 'https://www.tiktok.com/@curatedthreadsco' },
  { name: 'Facebook', url: 'https://www.facebook.com/share/19CkAy1XWj/' },
];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Curated Threads LLC',
  url: 'https://curatedthreadsoutdoors.com',
  sameAs: [
    'https://curatedthreadsllc.etsy.com/',
    'https://www.instagram.com/curatedthreads_co',
    'https://www.tiktok.com/@curatedthreadsco',
    'https://www.facebook.com/share/19CkAy1XWj/',
  ],
};
---

<BaseLayout
  title="Curated Threads Outdoors | Hunting, Fishing, Outdoor and Patriotic Gifts"
  description="Family-owned shop for hunting, fishing, outdoor, and patriotic t-shirts, hoodies, mugs, and can coolers. Free shipping on every order, fulfilled through our Etsy shop."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(organizationSchema)} />

  <main>
    <section class="bg-forest px-6 py-20 text-center text-cream sm:py-28">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-blaze">
        Family owned and operated
      </p>
      <h1 class="font-display mx-auto max-w-3xl text-4xl uppercase leading-tight sm:text-5xl">
        Curated Threads Outdoors
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-cream/90">
        Hunting, fishing, outdoor, and patriotic designs on shirts, hoodies, mugs, and can
        coolers. Made to order, shipped free.
      </p>
      <a
        href={etsyShopUrl}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-block rounded bg-blaze px-8 py-4 text-lg font-bold text-white shadow-lg transition hover:brightness-110"
      >
        Shop on Etsy
      </a>
    </section>

    <section class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="font-display text-center text-2xl uppercase text-forest sm:text-3xl">
        Four ways to gear up
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-ink/70">
        Full category pages are on the way. Until then, everything is live in our Etsy shop.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          categories.map((cat) => (
            <div class="rounded-lg border border-brown/20 bg-white p-6 shadow-sm">
              <h3 class="font-display text-xl uppercase text-forest">{cat.name}</h3>
              <p class="mt-2 text-ink/70">{cat.blurb}</p>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="bg-forest-dark px-6 py-10 text-center text-cream/80">
    <p class="font-display text-sm uppercase tracking-widest">Curated Threads LLC</p>
    <ul class="mt-4 flex justify-center gap-6">
      {
        social.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener" class="underline-offset-4 hover:text-blaze hover:underline">
              {s.name}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-sm text-cream/60">
      All orders are placed and fulfilled through our Etsy shop.
    </p>
  </footer>
</BaseLayout>
