---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { shopWithUtm, etsyImage, etsyImageSrcSet } from '../lib/etsy';
import heroGlacier from '../assets/hero-glacier.jpg';
import huntingCover from '../assets/categories/hunting.jpg';
import fishingCover from '../assets/categories/fishing.jpg';
import outdoorCover from '../assets/categories/outdoor.jpg';
import patrioticCover from '../assets/categories/patriotic.jpg';

const etsyShopUrl = shopWithUtm('home');

const allProducts = await getCollection('products');
const featured = allProducts.filter((p) => p.data.featured).slice(0, 8);

type Cat = 'hunting' | 'fishing' | 'outdoor' | 'patriotic';

// Secondary/hover image comes from a representative product photo in that
// category (Etsy CDN), so the primary is the branded lifestyle shot and the
// hover reveals a design in-context.
const hoverFor = (cat: Cat) => {
  const list = allProducts.filter((p) => p.data.category === cat);
  const featuredFirst = list.find((p) => p.data.featured) ?? list[0];
  return featuredFirst?.data.images[0];
};

const categories: {
  name: string;
  href: string;
  category: Cat;
  blurb: string;
  cover: ImageMetadata;
}[] = [
  {
    name: 'Hunting',
    href: '/hunting',
    category: 'hunting',
    blurb: 'Apparel, drinkware, and gifts for the hunter in your life.',
    cover: huntingCover,
  },
  {
    name: 'Fishing',
    href: '/fishing',
    category: 'fishing',
    blurb: 'Designs for the angler chasing the next big catch.',
    cover: fishingCover,
  },
  {
    name: 'Outdoor',
    href: '/outdoor',
    category: 'outdoor',
    blurb: 'Gear and gifts for anyone who lives outside.',
    cover: outdoorCover,
  },
  {
    name: 'Patriotic',
    href: '/patriotic',
    category: 'patriotic',
    blurb: 'Red, white, and blue designs made in the USA.',
    cover: patrioticCover,
  },
];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Curated Threads LLC',
  url: 'https://curatedthreadsoutdoors.com',
  sameAs: [
    'https://curatedthreadsllc.etsy.com/',
    'https://www.instagram.com/curatedthreadsoutdoors/',
    'https://www.tiktok.com/@curatedthreadsoutdoors',
    'https://www.pinterest.com/CuratedThreadsOutdoors',
    'https://www.facebook.com/profile.php?id=61587888253398',
  ],
};
---

<BaseLayout
  title="Curated Threads Outdoors | Hunting, Fishing, Outdoor and Patriotic Gifts"
  description="Family-owned shop for hunting, fishing, outdoor, and patriotic apparel, drinkware, and gifts. Free shipping on every order, fulfilled through our Etsy shop."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(organizationSchema)} />

  <section class="relative overflow-hidden border-b border-gold/30 bg-forest-dark text-cream">
    <Image
      src={heroGlacier}
      alt=""
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      quality={85}
      loading="eager"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-forest-dark/70 via-forest-dark/55 to-forest-dark/85"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-24 text-center sm:py-32">
      <p class="text-xs font-semibold uppercase tracking-[0.4em] text-gold drop-shadow">
        Family owned and operated
      </p>
      <h1 class="font-display mt-4 text-5xl leading-[1.05] text-cream drop-shadow-lg sm:text-6xl">
        For the field, the water, the trail, and the flag.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-cream/95 drop-shadow sm:text-xl">
        Hunting, fishing, outdoor, and patriotic designs on made-to-order apparel,
        drinkware, and gifts. Free shipping on every order, fulfilled through our Etsy shop.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
        <a
          href={etsyShopUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex w-full items-center justify-center rounded-sm bg-blaze px-8 py-4 text-base font-bold uppercase tracking-wider text-cream shadow-lg transition hover:brightness-110 sm:w-auto"
        >
          Shop the Etsy Collection
        </a>
        <a
          href="#collections"
          class="inline-flex w-full items-center justify-center rounded-sm border border-cream/70 bg-forest-dark/40 px-8 py-4 text-base font-bold uppercase tracking-wider text-cream backdrop-blur-sm transition hover:border-cream hover:bg-cream/10 sm:w-auto"
        >
          Browse the Collections
        </a>
      </div>
    </div>
  </section>

  <section id="collections" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-14">
    <div class="text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">Shop by collection</p>
      <h2 class="font-display mt-2 text-3xl text-sepia sm:text-4xl">Four ways to gear up</h2>
      <p class="mx-auto mt-3 max-w-2xl text-ink/70">
        Every collection is stocked in our Etsy shop and updated as new designs drop.
      </p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        categories.map((cat) => {
          const hover = hoverFor(cat.category);
          return (
            <a
              href={cat.href}
              class="group relative flex aspect-[4/5] overflow-hidden rounded-sm border border-gold/50 shadow-sm transition hover:border-forest hover:shadow-lg"
            >
              <Image
                src={cat.cover}
                alt=""
                widths={[400, 640, 900]}
                sizes="(min-width: 1024px) 22vw, (min-width: 640px) 46vw, 92vw"
                quality={85}
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105 group-hover:opacity-0"
              />
              {hover && (
                <img
                  src={etsyImage(hover.src, 'il_570xN')}
                  srcset={etsyImageSrcSet(hover.src, [
                    { variant: 'il_570xN', width: 570 },
                    { variant: 'il_794xN', width: 794 },
                  ])}
                  sizes="(min-width: 1024px) 22vw, (min-width: 640px) 46vw, 92vw"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover opacity-0 transition duration-500 group-hover:scale-105 group-hover:opacity-100"
                />
              )}
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-forest-dark/90 via-forest-dark/45 to-transparent" />
              <div class="relative z-10 mt-auto p-5 text-cream">
                <h3 class="font-display text-2xl leading-tight drop-shadow">{cat.name}</h3>
                <p class="mt-1 text-sm text-cream/90 drop-shadow">{cat.blurb}</p>
                <span class="mt-3 inline-block text-xs font-semibold uppercase tracking-widest text-blaze transition group-hover:text-cream">
                  Shop {cat.name} &rarr;
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="border-t border-gold/30 bg-parchment px-6 py-16">
        <div class="mx-auto max-w-6xl">
          <div class="text-center">
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">Bestsellers</p>
            <h2 class="font-display mt-2 text-3xl text-sepia sm:text-4xl">Fan favorites</h2>
            <p class="mx-auto mt-3 max-w-2xl text-ink/70">
              A handful of our most-loved designs. Every piece ships free from our Etsy shop.
            </p>
          </div>
          <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6 lg:grid-cols-4">
            {featured.map((p) => <ProductCard product={p} />)}
          </div>
          <div class="mt-10 text-center">
            <a
              href={etsyShopUrl}
              target="_blank"
              rel="noopener"
              class="inline-block rounded-sm border-2 border-forest px-8 py-3 text-sm font-bold uppercase tracking-wider text-forest transition hover:bg-forest hover:text-cream"
            >
              Shop all designs on Etsy
            </a>
          </div>
        </div>
      </section>
    )
  }

  <section class="border-t border-gold/30 bg-cream px-6 py-14">
    <div class="mx-auto grid max-w-5xl items-center gap-8 sm:grid-cols-[auto_1fr]">
      <div class="text-center sm:text-left">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">Our story</p>
        <p class="font-display mt-2 text-2xl leading-snug text-sepia sm:text-3xl">
          A family shop, run out of the truck bed as much as the office.
        </p>
      </div>
      <div class="text-center sm:text-left">
        <p class="text-ink/80">
          Daniel runs Curated Threads Outdoors and his daughter co-designs a portion of the
          catalog. They hunt and fish together, and it shows in the artwork.
        </p>
        <a
          href="/story"
          class="mt-4 inline-block text-sm font-semibold uppercase tracking-widest text-forest hover:text-blaze"
        >
          Read our story &rarr;
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-gold/30 bg-forest-dark px-6 py-14 text-center text-cream">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">Follow the adventure</p>
    <h2 class="font-display mt-2 text-3xl text-cream sm:text-4xl">Come along for the ride</h2>
    <p class="mx-auto mt-3 max-w-xl text-cream/80">
      New designs, behind-the-scenes drops, and moments from the field, the water, and the trail.
    </p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <a
        href="https://www.instagram.com/curatedthreadsoutdoors/"
        target="_blank"
        rel="noopener"
        class="rounded-sm border border-cream/40 px-5 py-3 text-sm font-semibold uppercase tracking-wider transition hover:border-blaze hover:text-blaze"
      >
        Instagram
      </a>
      <a
        href="https://www.tiktok.com/@curatedthreadsoutdoors"
        target="_blank"
        rel="noopener"
        class="rounded-sm border border-cream/40 px-5 py-3 text-sm font-semibold uppercase tracking-wider transition hover:border-blaze hover:text-blaze"
      >
        TikTok
      </a>
      <a
        href="https://www.pinterest.com/CuratedThreadsOutdoors"
        target="_blank"
        rel="noopener"
        class="rounded-sm border border-cream/40 px-5 py-3 text-sm font-semibold uppercase tracking-wider transition hover:border-blaze hover:text-blaze"
      >
        Pinterest
      </a>
      <a
        href="https://www.facebook.com/profile.php?id=61587888253398"
        target="_blank"
        rel="noopener"
        class="rounded-sm border border-cream/40 px-5 py-3 text-sm font-semibold uppercase tracking-wider transition hover:border-blaze hover:text-blaze"
      >
        Facebook
      </a>
    </div>
  </section>
</BaseLayout>
