---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { shopWithUtm, categoryCampaign } from '../lib/etsy';
import alaskaFjord from '../assets/alaska-fjord.jpg';

export async function getStaticPaths() {
  const categories = ['hunting', 'fishing', 'outdoor', 'patriotic'] as const;
  return categories.map((c) => ({ params: { category: c } }));
}

type Category = 'hunting' | 'fishing' | 'outdoor' | 'patriotic';
const category = Astro.params.category as Category;

// Sections mirror how the Etsy shop itself is organized (Tees, Hoodies,
// Youth, Cups/Mugs/Koozies, Decals & Accessories), so a shopper who knows
// the Etsy layout finds the same groupings here.
type Section = 'tees' | 'hoodies' | 'youth' | 'cups' | 'decals';
const sectionOrder: Section[] = ['tees', 'hoodies', 'youth', 'cups', 'decals'];
const sectionLabel: Record<Section, string> = {
  tees: 'T-Shirts',
  hoodies: 'Hoodies',
  youth: 'Youth',
  cups: 'Cups, Mugs & Koozies',
  decals: 'Decals & Accessories',
};
const cupTypes = new Set([
  'mug-11oz',
  'mug-15oz',
  'tumbler-22oz',
  'tumbler-40oz',
  'can-cooler',
  'whiskey-glass',
  'shot-glass',
  'pint-glass',
  'mixing-glass',
]);
const decalTypes = new Set(['vinyl-decal', 'vinyl-sticker', 'car-magnet', 'phone-case']);
const sectionOf = (p: { data: { product_type: string; youth: boolean } }): Section => {
  if (p.data.youth) return 'youth';
  if (p.data.product_type === 'tee' || p.data.product_type === 'tank-top') return 'tees';
  if (p.data.product_type === 'hoodie') return 'hoodies';
  if (cupTypes.has(p.data.product_type)) return 'cups';
  return 'decals';
};

// Hunting page leads with the whiskey glass, then shirts grouped by
// animal (deer, turkey, bear, duck/pheasant) in a specific curated order.
const huntingPriority = [
  'whitetail-deer-whiskey-rocks-glass-10oz-hunter-barware',
  'whitetail-fitness-deer-in-my-freezer-shirt-funny-deer-hunting-tee',
  'rustic-whitetail-buck-graphic-tee-outdoor-nature-lover-apparel',
  'whitetail-deer-hunter-graphic-tee-wildlife-buck-hunting-apparel',
  'whitetail-deer-skull-hoodie-rustic-nature-graphic-long-sleeve-tee',
  'turkey-hunter-shirt-vintage-wild-turkey-graphic-tee',
  'vintage-wild-turkey-hunter-graphic-t-shirt-100-cotton-hunting-tee',
  'bear-hunter-shirt-black-bear-hunting-graphic-tee',
  'mallard-duck-hunter-vintage-graphic-tee-waterfowl-hunting-apparel',
  'pheasant-hunting-shirt-for-men-upland-bird-hunter-gift',
  'pheasant-hunting-shirt-upland-bird-hunter-graphic-tee',
];

// Weaker designs get pushed to the very end of the hunting page, after
// every other product regardless of type.
const huntingLowPriority = new Set([
  'funny-big-buck-baby-deer-hunting-t-shirt-whitetail-graphic-tee',
  'i-ve-got-a-big-buck-baby-t-shirt-funny-deer-hunting-graphic-tee',
  'elk-hunting-shirt-big-game-hunter-graphic-tee',
  'elk-hunting-mug-big-game-hunter-coffee-cup',
]);

const allProducts = await getCollection('products');
const products = allProducts
  .filter((p) => p.data.category === category)
  .sort((a, b) => {
    if (category === 'hunting') {
      const aLow = huntingLowPriority.has(a.id);
      const bLow = huntingLowPriority.has(b.id);
      if (aLow !== bLow) return aLow ? 1 : -1;
      if (!aLow) {
        const ai = huntingPriority.indexOf(a.id);
        const bi = huntingPriority.indexOf(b.id);
        if (ai !== -1 || bi !== -1) {
          if (ai === -1) return 1;
          if (bi === -1) return -1;
          return ai - bi;
        }
      }
    }
    // Within each section: featured first, then newest publish_date
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    const da = a.data.publish_date?.getTime() ?? 0;
    const db = b.data.publish_date?.getTime() ?? 0;
    return db - da;
  });

// Group into the Etsy-style sections, preserving the sort order above
// within each group. Sections with no products for this category are
// simply omitted from the page.
const sections = sectionOrder
  .map((key) => ({ key, label: sectionLabel[key], products: products.filter((p) => sectionOf(p) === key) }))
  .filter((s) => s.products.length > 0);

const meta: Record<Category, { title: string; description: string; heroKicker: string; heroTitle: string; heroBody: string; storyLine?: string; bodyIntro: string }> = {
  hunting: {
    title: 'Hunting Apparel and Gifts | Curated Threads Outdoors',
    description:
      'Hunting apparel, drinkware, and gifts made to order. Free shipping through our Etsy shop.',
    heroKicker: 'For the field',
    heroTitle: 'Hunting',
    heroBody:
      'Designs for the hunter in your life, from opening day to the long walk back. Made to order and shipped free from our Etsy shop.',
    storyLine:
      "This is a father-daughter shop. When we're not designing, we're usually on a trail or a lake somewhere, and a lot of these pieces started as sketches on the drive home.",
    bodyIntro:
      'This collection covers whitetail, turkey, bear, elk, and waterfowl in graphic tees, hoodies, and drinkware built for the field and the truck bed after. Shirts are printed on soft, durable 100% cotton or cotton-poly blends with screen or DTG printing that holds up wash after wash, and the barware and tumblers are sized for camp coffee or a celebratory pour after a good hunt. Every piece is made to order through our Etsy shop, so nothing sits in a warehouse until someone picks it. Whether you are outfitting the hunter in your life for opening day or looking for a birthday, Father\'s Day, or Christmas gift for dad, mom, grandpa, grandma, a spouse, or a hunting buddy, these designs are built to actually get worn and used, not just unwrapped and set aside.',
  },
  fishing: {
    title: 'Fishing Apparel and Gifts | Curated Threads Outdoors',
    description:
      'Fishing apparel, drinkware, and gifts made to order. Free shipping through our Etsy shop.',
    heroKicker: 'For the water',
    heroTitle: 'Fishing',
    heroBody:
      'Designs for the angler in your life, from the first cast at dawn to the story told back home. Made to order and shipped free.',
    bodyIntro:
      'From largemouth bass to rainbow trout to deep sea marlin, this lineup is built for anglers who mark their calendars by the season. Tees and hoodies come in soft cotton and cotton-poly blends meant for early mornings on the dock or a boat, koozies and can coolers keep drinks cold between casts, and the mug and tumbler options are sized for coffee before sunrise or something colder after a good day out. Everything ships free and made to order through our Etsy shop. Looking for a gift for the angler in your life, whether that is dad, mom, a spouse, or the friend who plans every vacation around a charter, these pieces are designed to be worn on the water, not just displayed at home.',
  },
  outdoor: {
    title: 'Outdoor Apparel and Gifts | Curated Threads Outdoors',
    description:
      'Outdoor lifestyle apparel, gear, and gifts from Curated Threads Outdoors. Made to order, free shipping through our Etsy shop.',
    heroKicker: 'For the trail and the truck',
    heroTitle: 'Outdoor',
    heroBody:
      'Designs for anyone who spends their weekends chasing sunsets, dirt roads, and campfires.',
    bodyIntro:
      'This is the catalog for anyone whose weekends revolve around trailheads, campfires, and long drives with the windows down, not just hunting or fishing trips. Apparel is printed on soft, durable cotton and cotton-poly blends built to layer up at camp or wear around town, and the drinkware and accessories are made for coffee at the trailhead or a drink back at the tailgate. Every item is made to order and ships free through our Etsy shop. It is a solid pick for a birthday, holiday, or just-because gift for the outdoor lover in your life, whether that is a parent, a spouse, or a best friend who is always finding a reason to get outside.',
  },
  patriotic: {
    title: 'Patriotic USA Apparel and Gifts | Curated Threads Outdoors',
    description:
      'American flag, bald eagle, and USA pride designs. Made to order, free shipping through our Etsy shop.',
    heroKicker: 'For the flag',
    heroTitle: 'Patriotic',
    heroBody:
      'Red, white, and blue designs to wear your pride with. Made to order and shipped free.',
    bodyIntro:
      'This collection leans on distressed American flag graphics, bald eagle artwork, and America\'s 250th anniversary designs across tees, tanks, hoodies, and barware. Shirts are soft cotton and cotton-poly builds with durable printing meant to hold its color through repeated washes, and the glassware and drinkware options are sized for a Fourth of July cookout or a toast on any occasion that calls for one. Everything is made to order and ships free through our Etsy shop. These designs work well as a Fourth of July, Veterans Day, or Christmas gift for the patriot in your life, whether that is a parent, spouse, veteran, or friend who wears their pride without saying much about it.',
  },
};

const info = meta[category];
const shopUrl = shopWithUtm(categoryCampaign(category));
const siteBase = Astro.site!.origin;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteBase}/` },
    { '@type': 'ListItem', position: 2, name: info.heroTitle, item: `${siteBase}/${category}` },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${siteBase}/products/${p.id}`,
  })),
};
---

<BaseLayout title={info.title} description={info.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  {products.length > 0 && <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemListSchema)} />}

  {
    category === 'outdoor' ? (
      <section class="relative overflow-hidden border-b border-gold/30 bg-forest-dark text-cream">
        <Image
          src={alaskaFjord}
          alt="Calm Alaska fjord reflecting the surrounding mountains"
          widths={[768, 1280, 1920, 2400]}
          sizes="100vw"
          quality={85}
          loading="eager"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-forest-dark/70 via-forest-dark/55 to-forest-dark/85" />
        <div class="relative mx-auto max-w-4xl px-6 py-14 text-center sm:py-20">
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold drop-shadow">{info.heroKicker}</p>
          <h1 class="font-display mt-3 text-4xl text-cream drop-shadow-lg sm:text-5xl">{info.heroTitle}</h1>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-cream/95 drop-shadow">{info.heroBody}</p>
          {info.storyLine && <p class="mx-auto mt-4 max-w-2xl text-sm italic text-cream/80 drop-shadow">{info.storyLine}</p>}
        </div>
      </section>
    ) : (
      <section class="border-b border-gold/30 bg-parchment px-6 py-14 sm:py-20">
        <div class="mx-auto max-w-4xl text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">{info.heroKicker}</p>
          <h1 class="font-display mt-3 text-4xl text-sepia sm:text-5xl">{info.heroTitle}</h1>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-ink/75">{info.heroBody}</p>
          {info.storyLine && <p class="mx-auto mt-4 max-w-2xl text-sm italic text-sepia/70">{info.storyLine}</p>}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-4xl px-6 pt-10 text-center sm:pt-12">
    <p class="text-ink/75">{info.bodyIntro}</p>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-12">
    {
      products.length > 0 ? (
        <>
          {sections.length > 1 && (
            <nav aria-label="Jump to section" class="mb-10 flex flex-wrap justify-center gap-2">
              {sections.map((s) => (
                <a
                  href={`#${s.key}`}
                  class="rounded-full border border-gold/40 bg-cream px-4 py-1.5 text-sm font-semibold text-sepia transition hover:border-forest hover:text-forest"
                >
                  {s.label}
                </a>
              ))}
            </nav>
          )}
          {sections.map((s, i) => (
            <div id={s.key} class:list={['scroll-mt-24', i > 0 && 'mt-14 border-t border-gold/20 pt-12']}>
              {sections.length > 1 && (
                <h2 class="font-display mb-6 text-center text-2xl text-sepia">{s.label}</h2>
              )}
              <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6 lg:grid-cols-4">
                {s.products.map((p) => <ProductCard product={p} />)}
              </div>
            </div>
          ))}
        </>
      ) : (
        <div class="mx-auto max-w-xl rounded-sm border border-gold/40 bg-cream p-8 text-center">
          <p class="font-display text-xl text-sepia">New designs are on their way.</p>
          <p class="mt-3 text-ink/70">
            In the meantime, browse the full collection on our Etsy shop.
          </p>
          <a
            href={shopUrl}
            target="_blank"
            rel="noopener"
            class="mt-6 inline-block rounded-sm bg-forest px-6 py-3 font-bold text-cream transition hover:bg-forest-dark"
          >
            Shop on Etsy
          </a>
        </div>
      )
    }
  </section>

  {
    products.length > 0 && (
      <section class="border-t border-gold/20 bg-forest-dark px-6 py-12 text-center text-cream">
        <p class="font-display text-2xl">Ready to shop the full collection?</p>
        <a
          href={shopUrl}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-block rounded-sm bg-blaze px-8 py-4 text-lg font-bold text-white transition hover:brightness-110"
        >
          Shop on Etsy
        </a>
      </section>
    )
  }
</BaseLayout>
