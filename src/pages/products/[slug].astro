---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { etsyLink, etsyImage, etsyImageSrcSet } from '../../lib/etsy';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const data = product.data;

const allProducts = await getCollection('products');
const related = allProducts
  .filter((p) => p.data.category === data.category && p.id !== product.id)
  .slice(0, 3);

const primaryEtsy = etsyLink({
  listingUrl: data.etsy_listing_url,
  campaign: 'product_page',
  productSlug: product.id,
});

const cover = data.images[0];
const siteBase = Astro.site!.origin;

const categoryLabel = data.category.charAt(0).toUpperCase() + data.category.slice(1);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.title,
  description: data.short_description,
  image: data.images.map((img) => img.src),
  brand: { '@type': 'Brand', name: 'Curated Threads Outdoors' },
  offers: {
    '@type': 'Offer',
    url: primaryEtsy,
    priceCurrency: 'USD',
    price: (data.sale_price ?? data.list_price).toFixed(2),
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: 'Curated Threads LLC' },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteBase}/` },
    { '@type': 'ListItem', position: 2, name: categoryLabel, item: `${siteBase}/${data.category}` },
    { '@type': 'ListItem', position: 3, name: data.title, item: `${siteBase}/products/${product.id}` },
  ],
};

const pageTitle = `${data.title} | Curated Threads Outdoors`;
---

<BaseLayout title={pageTitle} description={data.short_description} ogImage={cover?.src ?? '/images/og-default.jpg'} ogType="product">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />

  <nav aria-label="Breadcrumb" class="border-b border-gold/20 bg-cream/60 px-6 py-3 text-sm text-sepia/80">
    <ol class="mx-auto flex max-w-6xl flex-wrap items-center gap-2">
      <li><a href="/" class="hover:text-forest">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={`/${data.category}`} class="hover:text-forest">{categoryLabel}</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-ink/60">{data.title}</li>
    </ol>
  </nav>

  <article class="mx-auto max-w-6xl px-6 py-8 sm:py-12">
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="space-y-3">
        {
          cover && (
            <div class="aspect-square w-full overflow-hidden rounded-sm border border-gold/40 bg-parchment">
              <img
                src={etsyImage(cover.src, 'il_1140xN')}
                srcset={etsyImageSrcSet(cover.src, [
                  { variant: 'il_794xN', width: 794 },
                  { variant: 'il_1140xN', width: 1140 },
                  { variant: 'il_1588xN', width: 1588 },
                ])}
                sizes="(min-width: 1024px) 44vw, 92vw"
                alt={cover.alt}
                width="1140"
                height="1140"
                class="h-full w-full object-cover"
              />
            </div>
          )
        }
        {
          data.images.length > 1 && (
            <div class="grid grid-cols-3 gap-2">
              {data.images.slice(1, 4).map((img) => (
                <div class="aspect-square overflow-hidden rounded-sm border border-gold/30 bg-parchment">
                  <img
                    src={etsyImage(img.src, 'il_570xN')}
                    srcset={etsyImageSrcSet(img.src, [
                      { variant: 'il_570xN', width: 570 },
                      { variant: 'il_794xN', width: 794 },
                    ])}
                    sizes="(min-width: 1024px) 14vw, 30vw"
                    alt={img.alt}
                    width="570"
                    height="570"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                </div>
              ))}
            </div>
          )
        }
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">{categoryLabel}</p>
        <h1 class="font-display mt-2 text-3xl leading-tight text-sepia sm:text-4xl">{data.title}</h1>

        <div class="mt-4 flex items-baseline gap-3">
          {
            data.sale_price ? (
              <>
                <span class="font-display text-3xl text-forest">${data.sale_price.toFixed(2)}</span>
                <span class="text-lg text-ink/40 line-through">${data.list_price.toFixed(2)}</span>
              </>
            ) : (
              <span class="font-display text-3xl text-forest">${data.list_price.toFixed(2)}</span>
            )
          }
          {data.free_shipping && <span class="ml-2 rounded-sm bg-forest/10 px-2 py-1 text-xs font-semibold uppercase tracking-wider text-forest">Free shipping</span>}
        </div>

        <p class="mt-6 text-lg text-ink/80">{data.short_description}</p>

        <a
          href={primaryEtsy}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex w-full items-center justify-center rounded-sm bg-forest px-8 py-4 text-lg font-bold text-cream shadow-md transition hover:bg-forest-dark sm:w-auto"
        >
          Shop on Etsy
        </a>

        <div class="mt-8">
          <h2 class="font-display text-xl text-sepia">Product Features:</h2>
          <ul class="mt-3 list-inside list-disc space-y-1 text-ink/80">
            {data.product_features.map((f) => <li>{f}</li>)}
          </ul>
        </div>

        <div class="mt-6">
          <h2 class="font-display text-xl text-sepia">Care Instructions:</h2>
          <ul class="mt-3 list-inside list-disc space-y-1 text-ink/80">
            {data.care_instructions.map((c) => <li>{c}</li>)}
          </ul>
        </div>

        <div class="prose prose-sepia mt-8 max-w-none text-ink/85">
          <Content />
        </div>

        <a
          href={primaryEtsy}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-flex w-full items-center justify-center rounded-sm border-2 border-forest px-8 py-3 font-bold uppercase tracking-wider text-forest transition hover:bg-forest hover:text-cream sm:w-auto"
        >
          Shop on Etsy
        </a>
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="mt-16 border-t border-gold/30 pt-12">
          <h2 class="font-display text-center text-2xl text-sepia">
            More from {categoryLabel}
          </h2>
          <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6">
            {related.map((p) => <ProductCard product={p} />)}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
