---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { etsyLink, etsyImage, etsyImageSrcSet } from '../../lib/etsy';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const data = product.data;

const allProducts = await getCollection('products');
const related = allProducts
  .filter((p) => p.data.category === data.category && p.id !== product.id)
  .slice(0, 3);

const primaryEtsy = etsyLink({
  listingUrl: data.etsy_listing_url,
  campaign: 'product_page',
  productSlug: product.id,
});

const cover = data.images[0];
const siteBase = Astro.site!.origin;

const categoryLabel = data.category.charAt(0).toUpperCase() + data.category.slice(1);

const apparelTypes = new Set(['tee', 'hoodie', 'tank-top']);
const isApparel = apparelTypes.has(data.product_type);

// Auto-refreshes to ~6 months from each build. Vercel redeploys on every push,
// so this keeps the offer eligible for Google Shopping without manual updates.
const priceValidUntil = (() => {
  const d = new Date();
  d.setMonth(d.getMonth() + 6);
  return d.toISOString().split('T')[0];
})();

// Google Merchant Center free-listings requires the landing URL to match
// the registered store domain, so the Product url and Offer url both point
// at our own product page. The buy-now link on the page still routes to Etsy.
const productPageUrl = `${siteBase}/products/${product.id}`;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.title,
  description: data.short_description,
  image: data.images.map((img) => img.src),
  sku: data.etsy_listing_id,
  productID: `etsy:${data.etsy_listing_id}`,
  url: productPageUrl,
  brand: { '@type': 'Brand', name: 'Curated Threads Outdoors' },
  ...(isApparel && {
    size: {
      '@type': 'SizeSpecification',
      sizeSystem: 'https://schema.org/WearableSizeSystemUS',
    },
  }),
  offers: {
    '@type': 'Offer',
    url: productPageUrl,
    priceCurrency: 'USD',
    price: (data.sale_price ?? data.list_price).toFixed(2),
    priceValidUntil,
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: 'Curated Threads Outdoors' },
    shippingDetails: {
      '@type': 'OfferShippingDetails',
      shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'USD' },
      shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'US' },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: { '@type': 'QuantitativeValue', minValue: 2, maxValue: 5, unitCode: 'DAY' },
        transitTime: { '@type': 'QuantitativeValue', minValue: 3, maxValue: 8, unitCode: 'DAY' },
      },
    },
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      applicableCountry: 'US',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      merchantReturnDays: 30,
      returnMethod: 'https://schema.org/ReturnByMail',
      returnFees: 'https://schema.org/FreeReturn',
      merchantReturnLink: `${siteBase}/faq`,
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteBase}/` },
    { '@type': 'ListItem', position: 2, name: categoryLabel, item: `${siteBase}/${data.category}` },
    { '@type': 'ListItem', position: 3, name: data.title, item: `${siteBase}/products/${product.id}` },
  ],
};

const pageTitle = `${data.title} | Curated Threads Outdoors`;
---

<BaseLayout title={pageTitle} description={data.short_description} ogImage={cover?.src ?? '/images/og-default.jpg'} ogType="product">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />

  <nav aria-label="Breadcrumb" class="border-b border-gold/20 bg-cream/60 px-6 py-3 text-sm text-sepia/80">
    <ol class="mx-auto flex max-w-6xl flex-wrap items-center gap-2">
      <li><a href="/" class="hover:text-forest">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={`/${data.category}`} class="hover:text-forest">{categoryLabel}</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-ink/60">{data.title}</li>
    </ol>
  </nav>

  <article class="mx-auto max-w-6xl px-6 py-8 sm:py-12">
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="space-y-3">
        {
          cover && (
            <div
              id="product-main-slot"
              data-original={cover.src}
              class="aspect-square w-full overflow-hidden rounded-sm border border-gold/40 bg-parchment"
            >
              <img
                id="product-main-image"
                src={etsyImage(cover.src, 'il_1140xN')}
                srcset={etsyImageSrcSet(cover.src, [
                  { variant: 'il_794xN', width: 794 },
                  { variant: 'il_1140xN', width: 1140 },
                  { variant: 'il_1588xN', width: 1588 },
                ])}
                sizes="(min-width: 1024px) 44vw, 92vw"
                alt={cover.alt}
                width="1140"
                height="1140"
                class="h-full w-full object-cover"
              />
            </div>
          )
        }
        {
          data.images.length > 1 && (
            <div class="grid grid-cols-3 gap-2">
              {data.images.slice(1, 4).map((img) => (
                <button
                  type="button"
                  data-product-thumb
                  data-original={img.src}
                  aria-label={`Show ${img.alt} as the main image`}
                  class="product-thumb aspect-square overflow-hidden rounded-sm border border-gold/30 bg-parchment p-0 transition hover:border-forest hover:ring-2 hover:ring-forest/40 focus:border-forest focus:outline-none focus-visible:ring-2 focus-visible:ring-forest/60"
                >
                  <img
                    src={etsyImage(img.src, 'il_570xN')}
                    srcset={etsyImageSrcSet(img.src, [
                      { variant: 'il_570xN', width: 570 },
                      { variant: 'il_794xN', width: 794 },
                    ])}
                    sizes="(min-width: 1024px) 14vw, 30vw"
                    alt={img.alt}
                    width="570"
                    height="570"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                </button>
              ))}
            </div>
          )
        }
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">{categoryLabel}</p>
        <h1 class="font-display mt-2 text-3xl leading-tight text-sepia sm:text-4xl">{data.title}</h1>

        <div class="mt-4 flex items-baseline gap-3">
          {
            data.sale_price ? (
              <>
                <span class="font-display text-3xl text-forest">${data.sale_price.toFixed(2)}</span>
                <span class="text-lg text-ink/40 line-through">${data.list_price.toFixed(2)}</span>
              </>
            ) : (
              <span class="font-display text-3xl text-forest">${data.list_price.toFixed(2)}</span>
            )
          }
          {data.free_shipping && <span class="ml-2 rounded-sm bg-forest/10 px-2 py-1 text-xs font-semibold uppercase tracking-wider text-forest">Free shipping</span>}
          {isApparel && <span class="rounded-sm bg-sepia/10 px-2 py-1 text-xs font-semibold uppercase tracking-wider text-sepia">US sizing</span>}
        </div>

        <p class="mt-6 text-lg text-ink/80">{data.short_description}</p>

        <a
          href={primaryEtsy}
          target="_blank"
          rel="noopener"
          data-pintrk-shop-etsy
          data-pintrk-value={(data.sale_price ?? data.list_price).toFixed(2)}
          data-pintrk-product-name={data.title}
          data-pintrk-product-id={product.id}
          class="mt-6 inline-flex w-full items-center justify-center rounded-sm bg-forest px-8 py-4 text-lg font-bold text-cream shadow-md transition hover:bg-forest-dark sm:w-auto"
        >
          Shop on Etsy
        </a>

        <div class="mt-8">
          <h2 class="font-display text-xl text-sepia">Product Features:</h2>
          <ul class="mt-3 list-inside list-disc space-y-1 text-ink/80">
            {data.product_features.map((f) => <li>{f}</li>)}
          </ul>
        </div>

        <div class="mt-6">
          <h2 class="font-display text-xl text-sepia">Care Instructions:</h2>
          <ul class="mt-3 list-inside list-disc space-y-1 text-ink/80">
            {data.care_instructions.map((c) => <li>{c}</li>)}
          </ul>
        </div>

        <div class="prose prose-sepia mt-8 max-w-none text-ink/85">
          <Content />
        </div>

        <a
          href={primaryEtsy}
          target="_blank"
          rel="noopener"
          data-pintrk-shop-etsy
          data-pintrk-value={(data.sale_price ?? data.list_price).toFixed(2)}
          data-pintrk-product-name={data.title}
          data-pintrk-product-id={product.id}
          class="mt-8 inline-flex w-full items-center justify-center rounded-sm border-2 border-forest px-8 py-3 font-bold uppercase tracking-wider text-forest transition hover:bg-forest hover:text-cream sm:w-auto"
        >
          Shop on Etsy
        </a>
      </div>
    </div>

    <script>
      // Product image gallery: click a thumbnail to swap it into the main slot
      // (and demote the previous main into the clicked thumbnail's slot).
      (function () {
        const mainSlot = document.getElementById('product-main-slot');
        const mainImg = document.getElementById('product-main-image');
        if (!mainSlot || !mainImg) return;
        const thumbs = document.querySelectorAll('[data-product-thumb]');
        const ETSY_VARIANT_RE = /il_(?:75x75|170x135|340x270|570xN|794xN|1140xN|1588xN|2000xN|fullxfull)\./;

        function withVariant(src, variant) {
          return ETSY_VARIANT_RE.test(src) ? src.replace(ETSY_VARIANT_RE, variant + '.') : src;
        }

        function paintMain(src, alt) {
          mainSlot.setAttribute('data-original', src);
          mainImg.src = withVariant(src, 'il_1140xN');
          mainImg.srcset = [
            withVariant(src, 'il_794xN') + ' 794w',
            withVariant(src, 'il_1140xN') + ' 1140w',
            withVariant(src, 'il_1588xN') + ' 1588w',
          ].join(', ');
          mainImg.alt = alt;
        }

        function paintThumb(thumb, src, alt) {
          thumb.setAttribute('data-original', src);
          thumb.setAttribute('aria-label', 'Show ' + alt + ' as the main image');
          const img = thumb.querySelector('img');
          if (!img) return;
          img.src = withVariant(src, 'il_570xN');
          img.srcset = [
            withVariant(src, 'il_570xN') + ' 570w',
            withVariant(src, 'il_794xN') + ' 794w',
          ].join(', ');
          img.alt = alt;
        }

        thumbs.forEach((thumb) => {
          thumb.addEventListener('click', () => {
            const prevMainSrc = mainSlot.getAttribute('data-original');
            const prevMainAlt = mainImg.alt;
            const clickedSrc = thumb.getAttribute('data-original');
            const clickedImg = thumb.querySelector('img');
            const clickedAlt = clickedImg ? clickedImg.alt : '';
            if (!prevMainSrc || !clickedSrc) return;

            paintMain(clickedSrc, clickedAlt);
            paintThumb(thumb, prevMainSrc, prevMainAlt);
          });
        });
      })();

      if (typeof window.pintrk === 'function') {
        window.pintrk('track', 'pagevisit', {
          event_id: crypto.randomUUID(),
        });
      }

      const firstEtsyLink = document.querySelector('[data-pintrk-shop-etsy]');
      if (typeof window.fbq === 'function' && firstEtsyLink) {
        window.fbq('track', 'ViewContent', {
          content_ids: [firstEtsyLink.getAttribute('data-pintrk-product-id')],
          content_type: 'product',
          content_name: firstEtsyLink.getAttribute('data-pintrk-product-name'),
          value: firstEtsyLink.getAttribute('data-pintrk-value'),
          currency: 'USD',
        });
      }
      if (typeof window.ttq !== 'undefined' && firstEtsyLink) {
        window.ttq.track('ViewContent', {
          contents: [
            {
              content_id: firstEtsyLink.getAttribute('data-pintrk-product-id'),
              content_type: 'product',
              content_name: firstEtsyLink.getAttribute('data-pintrk-product-name'),
            },
          ],
          value: firstEtsyLink.getAttribute('data-pintrk-value'),
          currency: 'USD',
        });
      }

      document.querySelectorAll('[data-pintrk-shop-etsy]').forEach((el) => {
        el.addEventListener('click', () => {
          const value = el.getAttribute('data-pintrk-value');
          const productName = el.getAttribute('data-pintrk-product-name');
          const productId = el.getAttribute('data-pintrk-product-id');

          if (typeof window.pintrk === 'function') {
            window.pintrk('track', 'AddToCart', {
              event_id: crypto.randomUUID(),
              value,
              currency: 'USD',
              line_items: [{ product_name: productName, product_id: productId }],
            });
          }

          if (typeof window.fbq === 'function') {
            window.fbq('track', 'AddToCart', {
              content_ids: [productId],
              content_type: 'product',
              content_name: productName,
              value,
              currency: 'USD',
            });
          }

          if (typeof window.ttq !== 'undefined') {
            window.ttq.track('AddToCart', {
              contents: [{ content_id: productId, content_type: 'product', content_name: productName }],
              value,
              currency: 'USD',
            });
          }
        });
      });
    </script>

    {
      related.length > 0 && (
        <section class="mt-16 border-t border-gold/30 pt-12">
          <h2 class="font-display text-center text-2xl text-sepia">
            More from {categoryLabel}
          </h2>
          <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6">
            {related.map((p) => <ProductCard product={p} />)}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
